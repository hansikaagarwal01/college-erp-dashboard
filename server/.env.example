# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# MongoDB — never commit real credentials. Use your own URI.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/collegeERP

# JWT — production should use a long random string, e.g.:
#   openssl rand -hex 64
# Access token (short-lived)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE=15m

# Refresh token (long-lived, rotating). Separate secret recommended.
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-secret
REFRESH_TOKEN_EXPIRE=7d

# Rate limiting (optional overrides)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=5

# Seed admin (npm run seed:admin)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=ChangeMe123!
